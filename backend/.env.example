# ==============================================================================
# SMART LIBRARY SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development

# 1. PostgreSQL / Supabase Database Connection
# Copy from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres.xxxxxx:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_SSL=true

# 2. Supabase API & Service Role Configuration
# Copy from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. JWT Authentication Secrets (Keep confidential in production)
JWT_ACCESS_SECRET=smart_library_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=smart_library_refresh_secret_ultra_secure_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 4. CORS Allowed Origin (Set to your Vercel URL in production)
CORS_ORIGIN=http://localhost:3000
